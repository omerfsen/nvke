apiVersion: v1
kind: Pod
metadata:
  name: gpu-operator-smoke-test
  namespace: {{ gpu_operator_namespace }}
spec:
  restartPolicy: Never
  containers:
    - name: vectoradd
      image: {{ gpu_operator_smoke_test_image }}
      resources:
        limits:
          nvidia.com/gpu: 1
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop: [ALL]
